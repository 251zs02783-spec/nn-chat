doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="style.css")
    title ToDoリスト
  body.container.overflow-scroll(data-bs-theme=currentTheme)
    nav.navbar.fixed-top.bg-primary
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto ToDoリスト
          i.bi-check2-square.ms-1
        div.dropdown
          button.btn.btn-outline-light.dropdown-toggle(type="button" id="menu" data-bs-toggle="dropdown" aria-expanded="false") #{user}
            i.bi-gear-fill.ms-1
          ul.dropdown-menu.dropdown-menu-end(aria-labelledby="menu")
            li
              - const changeThemeText = (currentTheme === 'light' ? 'ダークモードに切り替え' : 'ライトモードに切り替え');
              a.dropdown-item(href="/changeTheme") #{changeThemeText}
              a.dropdown-item(href="/logout") ログアウト

    div.mt-5.pt-4

    //- タスク一覧の表示
    each task in tasks
      //- 完了している場合は背景色と文字色を暗くする
      - const cardClass = (task.isDone ? 'card my-2 bg-light text-muted' : 'card my-2 border-primary')
      div(class=cardClass)
        div.card-body.d-flex.align-items-center.justify-content-between.p-3
          div.d-flex.align-items-center
            //- 完了/未完了の切り替えボタン
            form(method="post" action="/tasks/toggle" class="mb-0 me-3")
              input(type="hidden" name="id" value=task.id)
              //- 現在の状態の逆を送信する
              input(type="hidden" name="isDone" value=(task.isDone ? 'false' : 'true'))
              button.btn.btn-sm(type="submit", class=(task.isDone ? 'btn-success' : 'btn-outline-secondary'))
                i(class=(task.isDone ? 'bi-check-circle-fill' : 'bi-circle'))
            
            //- タスクの内容
            div
              - const textStyle = task.isDone ? 'text-decoration-line-through' : ''
              h5.card-title.mb-1(class=textStyle) #{task.content}
              small.text-muted 登録者: #{task.postedBy} / #{task.relativeCreatedAt}
              if task.deadline
                span.badge.bg-warning.text-dark.ms-2 期限: #{task.deadline}

          //- 削除ボタン
          - const isDeletable = (user === task.postedBy || user === 'admin')
          if isDeletable
            form(method="post" action="/tasks/delete" class="mb-0")
              input(type="hidden" name="id" value=task.id)
              button(type="submit").btn.btn-outline-danger.btn-sm
                i.bi-trash

    div(style="height: 100px;")

    div.fixed-bottom.p-3.bg-body.border-top
      form(method="post" action="/tasks" name="task-form").container-fluid.row.g-2.align-items-center
        div.col-9.col-md-10
          input(type="text" name="content" required placeholder="新しいタスクを入力...").form-control
          input(type="date" name="deadline").form-control.w-25
          input(type="hidden" name="oneTimeToken" value=oneTimeToken)
        div.col-3.col-md-2
          button(type="submit").btn.btn-primary.w-100
            i.bi-plus-lg
            span.d-none.d-md-inline.ms-1 

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")